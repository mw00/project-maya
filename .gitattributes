# Frozen prompts are hashed byte for byte (manifest sha256): never convert their line endings.
bench/prompts/** -text

# the setup screen's Python packages (maya.py installs them from here, offline): zip files, byte for byte
third_party/wheels/** -text

# launchers keep their platform line endings wherever the repository is cloned
*.sh text eol=lf
*.bat text eol=crlf

# the glm5_next parity fixtures are BINARY float data - never convert line endings
data/glm5-synth-dumps/** -text
data/glm5-synth.gguf -text
data/glm5-synth-dumps12/** -text
data/glm5-big-dumps/** -text

# a patch applied at configure time (CMakeLists.txt, the MMQ sources): byte for byte
third_party/ggml/*.patch -text

# the official DeepSeek-V4.1 encoding fixtures are compared byte for byte (serve/test_ds41_conformance.py)
serve/fixtures/deepseek_v41/** -text
# ... and MiniMax-M3.1-Flash's own chat template (serve/test_minimax_frontend.py checks its sha256)
serve/fixtures/minimax_m31/chat_template.jinja -text
