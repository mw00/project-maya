{
 "name": "L",
 "note": "RTX 3090 24 GB + 64 GB RAM. IQ4_XS gate/up (GPTQ), Q5_K down; the first and last two MoE layers one step up (Q5_K / Q6_K); the MTP layer IQ3_XXS / IQ4_XS; Q8_0 attention, KDA and shared experts; Q8_0 token embeddings (what maya-ling reads)",
 "rules": [
  {
   "match": "^blk\\.42\\.ffn_(gate|up)_exps",
   "type": "IQ3_XXS"
  },
  {
   "match": "^blk\\.42\\.ffn_down_exps",
   "type": "IQ4_XS"
  },
  {
   "match": "^blk\\.(2|3|40|41)\\.ffn_(gate|up)_exps",
   "type": "Q5_K"
  },
  {
   "match": "^blk\\.(2|3|40|41)\\.ffn_down_exps",
   "type": "Q6_K"
  },
  {
   "match": "ffn_(gate|up)_exps",
   "type": "IQ4_XS"
  },
  {
   "match": "ffn_down_exps",
   "type": "Q5_K"
  },
  {
   "match": "ffn_gate_inp|exp_probs_b|ssm_a|ssm_dt|ssm_conv1d",
   "type": "F32"
  },
  {
   "match": "ssm_beta|attn_gate|attn_k_b|attn_v_b",
   "type": "Q8_0"
  },
  {
   "match": "^token_embd",
   "type": "Q8_0"
  },
  {
   "match": "^output\\.weight",
   "type": "Q8_0"
  }
 ],
 "default": "Q8_0"
}