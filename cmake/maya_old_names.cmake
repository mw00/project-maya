# cmake/maya_old_names.cmake - the build options are MAYA_X since v1.1.75; the older STRATA_X spelling still works
# for a while: -DSTRATA_X=... (or a STRATA_X left in an existing build folder's cache) sets MAYA_X, with one
# deprecation line.  MAYA_X wins when both are set.  The STRATA_X cache entry is dropped once read, so the note
# shows once.  Included first thing by CMakeLists.txt and tools/vision/CMakeLists.txt.
get_cmake_property(_maya_cache CACHE_VARIABLES)
set(_maya_moved "")
foreach(_v IN LISTS _maya_cache)
  if(_v MATCHES "^STRATA_(.+)$")
    set(_n "MAYA_${CMAKE_MATCH_1}")
    if(DEFINED CACHE{${_n}})
      if(NOT "${${_v}}" STREQUAL "${${_n}}")
        message(WARNING "${_v}=${${_v}} is ignored: ${_n}=${${_n}} is set (the old STRATA_ names count only alone)")
      endif()
    else()
      get_property(_t CACHE ${_v} PROPERTY TYPE)
      if(_t STREQUAL "" OR _t STREQUAL "UNINITIALIZED" OR _t STREQUAL "INTERNAL" OR _t STREQUAL "STATIC")
        set(_t STRING)
      endif()
      get_property(_h CACHE ${_v} PROPERTY HELPSTRING)
      set(${_n} "${${_v}}" CACHE ${_t} "${_h}")
      list(APPEND _maya_moved "${_v}")
    endif()
    unset(${_v} CACHE)
  endif()
endforeach()
if(_maya_moved)
  list(JOIN _maya_moved ", " _maya_moved)
  message(DEPRECATION "old build option names (use MAYA_ in their place; they were taken as MAYA_*): ${_maya_moved}")
endif()
unset(_maya_moved)
unset(_maya_cache)
