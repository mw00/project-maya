# cmake/k31_guard.cmake - maya-k31 keeps DeepSeek's 8-pick structures out (docs/K31-ENGINE.md §1.2 item 1, plan §10.1):
# no K3.1 file includes src/ds4/ds4_kernels.cuh (kPicks, the 8-stride window kernels) or src/ds4/ds4_model.hpp.
#
#   cmake -DSRC=<source dir> -P cmake/k31_guard.cmake
#       the #include lines of src/k31/* and tests/k31_* (configure runs this: CMakeLists.txt, STRATA_BUILD_K31)
#   cmake -DSRC=<source dir> -DBUILD=<build dir> -DMAKE=<ninja or make> -DGENERATOR=<generator> -DTARGETS=<a,b,...>
#         -P cmake/k31_guard.cmake
#       also every object of those targets, through its whole compiled include closure (the compiler's own dependency
#       lists: ninja -t deps, or the depfiles a Makefile build keeps); the k31_include_guard test runs this.  A target
#       with no compiled object is a failure (an unbuilt tree proves nothing).
# Exit 0 and one summary line when clean; otherwise every offending file and line, and a non-zero exit.
cmake_minimum_required(VERSION 3.24)

set(_banned_re "ds4_kernels\\.cuh|ds4_model\\.hpp")
if(NOT SRC)
  message(FATAL_ERROR "k31_guard: -DSRC=<source dir> is required")
endif()

set(_bad)
file(GLOB _files LIST_DIRECTORIES false "${SRC}/src/k31/*" "${SRC}/tests/k31_*")
if(NOT _files)
  message(FATAL_ERROR "k31_guard: no files under ${SRC}/src/k31 or ${SRC}/tests/k31_*")
endif()
list(LENGTH _files _n_files)
foreach(_f IN LISTS _files)
  file(STRINGS "${_f}" _hits REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"][^>\"]*(${_banned_re})[>\"]")
  foreach(_h IN LISTS _hits)
    file(RELATIVE_PATH _r "${SRC}" "${_f}")
    list(APPEND _bad "${_r}: ${_h}")
  endforeach()
endforeach()

set(_summary "k31_guard: ${_n_files} K3.1 files, none includes ds4_kernels.cuh or ds4_model.hpp")

if(BUILD)
  if(NOT TARGETS)
    message(FATAL_ERROR "k31_guard: -DBUILD needs -DTARGETS=<the k31 targets>")
  endif()
  string(REPLACE "," ";" _targets "${TARGETS}")
  set(_objs_total 0)
  set(_deps_total 0)
  if(GENERATOR MATCHES "Ninja")
    # every k31 object the build graph has, then their recorded dependencies
    execute_process(COMMAND "${MAKE}" -C "${BUILD}" -t targets all OUTPUT_VARIABLE _all RESULT_VARIABLE _rc
                    ERROR_VARIABLE _err)
    if(NOT _rc EQUAL 0)
      message(FATAL_ERROR "k31_guard: ${MAKE} -t targets all failed: ${_err}")
    endif()
    string(REPLACE "\n" ";" _all "${_all}")
    foreach(_t IN LISTS _targets)
      set(_objs)
      foreach(_line IN LISTS _all)
        if(_line MATCHES "^(CMakeFiles/${_t}\\.dir/[^:]+\\.o(bj)?): ")
          list(APPEND _objs "${CMAKE_MATCH_1}")
        endif()
      endforeach()
      if(NOT _objs)
        list(APPEND _bad "${_t}: no objects in the build graph")
        continue()
      endif()
      execute_process(COMMAND "${MAKE}" -C "${BUILD}" -t deps ${_objs} OUTPUT_VARIABLE _deps RESULT_VARIABLE _rc
                      ERROR_VARIABLE _err)
      if(NOT _rc EQUAL 0)
        message(FATAL_ERROR "k31_guard: ${MAKE} -t deps failed: ${_err}")
      endif()
      string(REPLACE "\n" ";" _deps "${_deps}")
      set(_cur "")
      set(_with_deps 0)
      foreach(_line IN LISTS _deps)
        if(_line MATCHES "^([^ ][^:]*): #deps ([0-9]+)")
          set(_cur "${CMAKE_MATCH_1}")
          if(CMAKE_MATCH_2 GREATER 0)
            math(EXPR _with_deps "${_with_deps} + 1")
            math(EXPR _deps_total "${_deps_total} + ${CMAKE_MATCH_2}")
          endif()
        elseif(_line MATCHES "(${_banned_re})$")
          string(STRIP "${_line}" _l)
          list(APPEND _bad "${_cur} (${_t}) includes ${_l}")
        endif()
      endforeach()
      list(LENGTH _objs _n)
      if(NOT _with_deps EQUAL _n)
        list(APPEND _bad "${_t}: ${_with_deps} of ${_n} objects have recorded dependencies (build the target first)")
      endif()
      math(EXPR _objs_total "${_objs_total} + ${_n}")
    endforeach()
  else()
    # a Makefile build keeps the depfiles: CMakeFiles/<target>.dir/**/*.d and compiler_depend.make
    foreach(_t IN LISTS _targets)
      file(GLOB_RECURSE _dfiles "${BUILD}/CMakeFiles/${_t}.dir/*.d" "${BUILD}/CMakeFiles/${_t}.dir/compiler_depend.make")
      if(NOT _dfiles)
        list(APPEND _bad "${_t}: no dependency files under ${BUILD}/CMakeFiles/${_t}.dir (build the target first)")
        continue()
      endif()
      foreach(_d IN LISTS _dfiles)
        file(STRINGS "${_d}" _hits REGEX "(${_banned_re})")
        foreach(_h IN LISTS _hits)
          string(STRIP "${_h}" _h)
          list(APPEND _bad "${_d} (${_t}): ${_h}")
        endforeach()
        math(EXPR _objs_total "${_objs_total} + 1")
      endforeach()
    endforeach()
  endif()
  list(LENGTH _targets _n_targets)
  string(APPEND _summary "; ${_objs_total} objects of ${_n_targets} targets, ${_deps_total} recorded includes, "
         "neither header among them")
endif()

if(_bad)
  list(JOIN _bad "\n  " _bad_s)
  message(FATAL_ERROR "k31_guard: a K3.1 file reaches DeepSeek's 8-pick code (ds4_kernels.cuh / ds4_model.hpp; "
                      "docs/K31-ENGINE.md §1.2 item 1):\n  ${_bad_s}")
endif()
message(STATUS "${_summary}")
