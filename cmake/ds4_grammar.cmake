# Tokenizer-aware constrained decoding uses the same pinned llama.cpp as ggml.
# llama is CPU-only, vocab-only at runtime; no second inference engine is loaded.
# CPU-only and unrelated engine builds retain their existing dependency graph.
# An explicit ON also allows building the metadata-only checker without DS4.
set(_ds4_grammar_default OFF)
if(TARGET maya-ds4 AND STRATA_NATIVE_EXPERTS)
  set(_ds4_grammar_default ON)
endif()
option(MAYA_DS4_GRAMMAR "Enable DeepSeek native GBNF constrained decoding" ${_ds4_grammar_default})
if(MAYA_DS4_GRAMMAR)
  if(NOT STRATA_NATIVE_EXPERTS)
    message(FATAL_ERROR "MAYA_DS4_GRAMMAR requires STRATA_NATIVE_EXPERTS")
  endif()
  set(_grammar_src "${STRATA_GGML_DIR}")
  if(NOT _grammar_src)
    set(_grammar_src "${strata_llamacpp_SOURCE_DIR}")
  endif()
  if(NOT EXISTS "${_grammar_src}/src/llama-grammar.cpp")
    message(FATAL_ERROR "DeepSeek grammar requires the full pinned llama.cpp source")
  endif()
  file(GLOB _grammar_core CONFIGURE_DEPENDS "${_grammar_src}/src/*.cpp")
  file(GLOB _grammar_models CONFIGURE_DEPENDS "${_grammar_src}/src/models/*.cpp")
  list(REMOVE_ITEM _grammar_core "${_grammar_src}/src/llama-sampler.cpp")
  set(_state "${CMAKE_CURRENT_LIST_DIR}/../src/ds4/ds4_grammar_state.cpp")
  set_source_files_properties("${_state}" PROPERTIES
    COMPILE_DEFINITIONS "MAYA_DS4_LLAMA_SAMPLER_SOURCE=\"${_grammar_src}/src/llama-sampler.cpp\"")
  add_library(maya_ds4_grammar STATIC ${_grammar_core} ${_grammar_models} "${_state}")
  target_compile_features(maya_ds4_grammar PUBLIC cxx_std_17)
  # Preserve the pinned source's version macros rather than borrowing Maya's.
  file(STRINGS "${_grammar_src}/CMakeLists.txt" _grammar_version_lines
    REGEX "^set\\(LLAMA_VERSION_(MAJOR|MINOR|PATCH) [0-9]+\\)")
  set(LLAMA_VERSION "maya-grammar")
  set(LLAMA_VERSION_MAJOR 0)
  set(LLAMA_VERSION_MINOR 0)
  set(LLAMA_VERSION_PATCH 0)
  foreach(_line IN LISTS _grammar_version_lines)
    if(_line MATCHES "^set\\((LLAMA_VERSION_(MAJOR|MINOR|PATCH)) ([0-9]+)\\)")
      set("${CMAKE_MATCH_1}" "${CMAKE_MATCH_3}")
    endif()
  endforeach()
  if(_grammar_version_lines)
    set(LLAMA_VERSION "${LLAMA_VERSION_MAJOR}.${LLAMA_VERSION_MINOR}.${LLAMA_VERSION_PATCH}-maya-grammar")
  endif()
  set(LLAMA_BUILD_NUMBER 0)
  set(LLAMA_BUILD_COMMIT "pinned")
  configure_file("${_grammar_src}/src/llama-version.h.in" "${CMAKE_CURRENT_BINARY_DIR}/ds4-grammar/llama-version.h" @ONLY)
  target_include_directories(maya_ds4_grammar PRIVATE "${_grammar_src}/src" "${CMAKE_CURRENT_BINARY_DIR}/ds4-grammar"
    PUBLIC "${_grammar_src}/include" "${_grammar_src}/vendor/nlohmann" "${CMAKE_CURRENT_LIST_DIR}/../src/ds4")
  target_compile_definitions(maya_ds4_grammar PUBLIC MAYA_DS4_GRAMMAR=1)
  target_link_libraries(maya_ds4_grammar PUBLIC ggml)
  if(TARGET maya-ds4)
    target_link_libraries(maya-ds4 PRIVATE maya_ds4_grammar)
  endif()
  add_executable(maya-ds4-grammar-check "${CMAKE_CURRENT_LIST_DIR}/../tools/ds4/grammar_check.cpp")
  target_link_libraries(maya-ds4-grammar-check PRIVATE maya_ds4_grammar)
  if(MINGW)
    target_link_options(maya-ds4-grammar-check PRIVATE -municode)
  endif()
endif()
if(MAYA_DS4_GRAMMAR)
  add_executable(maya-ds4-grammar-state-test EXCLUDE_FROM_ALL "${CMAKE_CURRENT_LIST_DIR}/../tools/ds4/grammar_state_test.cpp")
  target_link_libraries(maya-ds4-grammar-state-test PRIVATE maya_ds4_grammar)
endif()
if(STRATA_BUILD_TESTS)
  add_executable(ds4_grammar_path_test "${CMAKE_CURRENT_LIST_DIR}/../tests/ds4_grammar_path_test.cpp")
  target_include_directories(ds4_grammar_path_test PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../src/ds4")
  add_test(NAME ds4_grammar_path_test COMMAND ds4_grammar_path_test)
endif()
