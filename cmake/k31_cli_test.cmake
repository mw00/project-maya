# cmake/k31_cli_test.cmake - maya-k31's command line (the maya_k31_cli test): --version, and each refusal with its
# exit code and its message.  No GPU and no model: --pack-info's geometry refusals are k31_geo_test's (the same
# k31::read, its messages printed as they are), this checks the program around them.
#   cmake -DEXE=<maya-k31> -DWORK=<scratch dir> -DSRC=<source dir> -DBUILD_ID_H=<build>/generated/maya_build_id.h
#         -P cmake/k31_cli_test.cmake
# --version must print the VERSION file's release and the build id cmake/build_id.cmake wrote for this tree, not the
# fallback k31_main.cpp prints without that header ("maya-k31 ? (build unknown)").
cmake_minimum_required(VERSION 3.24)
if(NOT EXE OR NOT WORK OR NOT SRC OR NOT BUILD_ID_H)
  message(FATAL_ERROR "k31_cli_test: -DEXE=<maya-k31> -DWORK=<dir> -DSRC=<source dir> -DBUILD_ID_H=<header> are required")
endif()
if(NOT EXISTS "${BUILD_ID_H}")
  message(FATAL_ERROR "k31_cli_test: ${BUILD_ID_H} is missing: maya-k31 was built without its build id")
endif()
file(STRINGS "${SRC}/VERSION" _release LIMIT_COUNT 1)
string(STRIP "${_release}" _release)
file(STRINGS "${BUILD_ID_H}" _id_line REGEX "^#define MAYA_BUILD_ID \"")
string(REGEX REPLACE "^#define MAYA_BUILD_ID \"([^\"]*)\".*$" "\\1" _id "${_id_line}")
if(_release STREQUAL "" OR _id STREQUAL "" OR (_id STREQUAL "unknown" AND EXISTS "${SRC}/.git"))
  message(FATAL_ERROR "k31_cli_test: no release ('${_release}') or build id ('${_id}') to check --version against")
endif()
string(REGEX REPLACE "([][+.*?()^$|\\])" "\\\\\\1" _release_re "${_release}")
string(REGEX REPLACE "([][+.*?()^$|\\])" "\\\\\\1" _id_re "${_id}")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

set(_fails 0)
set(_n 0)
# case(<rc> <stdout regex or -> <stderr regex or -> args...)
function(case rc out_re err_re)
  execute_process(COMMAND "${EXE}" ${ARGN} RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  set(_why)
  if(NOT "${_rc}" STREQUAL "${rc}")
    list(APPEND _why "exit ${_rc}, wanted ${rc}")
  endif()
  if(NOT out_re STREQUAL "-" AND NOT _out MATCHES "${out_re}")
    list(APPEND _why "stdout does not match '${out_re}'")
  endif()
  if(NOT err_re STREQUAL "-" AND NOT _err MATCHES "${err_re}")
    list(APPEND _why "stderr does not match '${err_re}'")
  endif()
  math(EXPR _n "${_n} + 1")
  set(_n ${_n} PARENT_SCOPE)
  if(_why)
    list(JOIN _why "; " _w)
    message("FAIL: maya-k31 ${ARGN}: ${_w}\n  stdout: ${_out}\n  stderr: ${_err}")
    math(EXPR _fails "${_fails} + 1")
    set(_fails ${_fails} PARENT_SCOPE)
  else()
    message("ok: maya-k31 ${ARGN} (exit ${_rc})")
  endif()
endfunction()

file(WRITE "${WORK}/not.gguf" "this is not a GGUF file\n")
file(WRITE "${WORK}/short.gguf" "GGUF")

case(0 "^maya-k31 ${_release_re} \\(build ${_id_re}\\)\n$" "^$" --version)
case(2 "^$" "usage: maya-k31 --pack-info FILE")
case(0 "usage: maya-k31 --pack-info FILE" "^$" --help)
case(2 "^$" "^maya-k31: unknown option --bogus\n" --bogus)
# --version and --help stand alone, before or after anything else
case(2 "^$" "^maya-k31: --version takes no other arguments\n" --version --bogus)
case(2 "^$" "^maya-k31: --version takes no other arguments\n" --version --serve)
case(2 "^$" "^maya-k31: --version takes no other arguments\n" --pack-info "${WORK}/not.gguf" --version)
case(2 "^$" "^maya-k31: unknown option --bogus\n" --bogus --version)
case(2 "^$" "^maya-k31: --help takes no other arguments\n" --help --bogus)
case(2 "^$" "^maya-k31: -h takes no other arguments\n" --pack-info "${WORK}/not.gguf" -h)
case(2 "^$" "^maya-k31: --pack-info needs a GGUF file\n" --pack-info)
case(2 "^$" "^maya-k31: --eps takes moonshot or llama.cpp, not 'fast'\n" --pack-info "${WORK}/not.gguf" --eps fast)
case(2 "^$" "^maya-k31: --eps needs a value\n" --pack-info "${WORK}/not.gguf" --eps)
case(2 "^$" "^maya-k31: one GGUF file at a time \\(also given " --pack-info "${WORK}/not.gguf" "${WORK}/short.gguf")
case(2 "^$" "^maya-k31: nothing to do: give --pack-info FILE or --version\n" --eps moonshot)
foreach(_m IN ITEMS --serve --score --dump-raw-dir --bench --experts)
  case(2 "^$" "^maya-k31: ${_m} is not built yet \\(this build has --version and --pack-info\\)\n" ${_m})
endforeach()
case(1 "^$" "^maya-k31: cannot read ${WORK}/missing.gguf: no such file\n" --pack-info "${WORK}/missing.gguf")
case(1 "^$" "^maya-k31: cannot read ${WORK}/not.gguf: not a GGUF file \\(bad magic\\)\n" --pack-info "${WORK}/not.gguf")
case(1 "^$" "^maya-k31: cannot read ${WORK}/short.gguf: GGUF: unexpected end of file in header\n" --pack-info "${WORK}/short.gguf")
case(1 "^$" "^maya-k31: cannot read ${WORK}: not a regular file\n" --pack-info "${WORK}")

if(_fails GREATER 0)
  message(FATAL_ERROR "k31_cli_test: ${_fails} of ${_n} cases failed")
endif()
message("k31_cli_test: ${_n} cases ok")
