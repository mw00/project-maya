+        /*.nb_q2  =*/ q->nb[2],
+        /*.nb_k1  =*/ k->nb[1],
+        /*.nb_i1  =*/ ids->nb[1],
+        /*.nb_m1  =*/ mask->nb[1],
+        /*.nb_d1  =*/ op->nb[1],
+        /*.nb_d2  =*/ op->nb[2],
+        /*.scale  =*/ ggml_get_op_params_f32(op, 0),
