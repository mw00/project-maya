+// ggml_sparse_mla
+
+struct ggml_tensor * ggml_sparse_mla(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * k,
+        struct ggml_tensor  * idx,
+        struct ggml_tensor  * mask,
+        float                 scale) {
+    GGML_ASSERT(q->type == GGML_TYPE_F32 && (k->type == GGML_TYPE_F16 || k->type == GGML_TYPE_F32));
+    GGML_ASSERT(idx->type == GGML_TYPE_I32 && mask->type == GGML_TYPE_F32);
+    GGML_ASSERT(q->ne[0] == k->ne[0] && q->ne[3] == 1 && k->ne[2] == 1 && k->ne[3] == 1);
+    GGML_ASSERT(idx->ne[1] == q->ne[2] && idx->ne[2] == 1 && idx->ne[3] == 1);
+    GGML_ASSERT(ggml_are_same_shape(idx, mask));
+
+    struct ggml_tensor * result = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, q->ne[0], q->ne[1], q->ne[2]);
+
+    ggml_set_op_params_f32(result, 0, scale);
+
+    result->op     = GGML_OP_SPARSE_MLA;
+    result->src[0] = q;
+    result->src[1] = k;
+    result->src[2] = idx;
+    result->src[3] = mask;
+
+    return result;
+}
