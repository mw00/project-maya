+// sparse MQA attention (ggml_sparse_mla): a threadgroup per (token, group of up to 8 heads), a simdgroup per head.
+// The token's selected rows are staged 16 at a time in threadgroup memory and read by every head of the group; each
+// lane keeps D/32 elements of its head's query and output, with an online softmax over the blocks.  T: the cache's
+// element type (half, or float: 32 KB of staged rows at D = 512, the threadgroup memory limit).
+template <typename T, typename T4, int D>
+kernel void kernel_sparse_mla(
+        constant ggml_metal_kargs_sparse_mla & args,
+        device const char * q,
+        device const char * k,
+        device const char * ids,
+        device const char * mask,
+        device       char * dst,
+        threadgroup     T * shk [[threadgroup(0)]],
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort  tiitg[[thread_index_in_threadgroup]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]],
+        ushort3   ntg[[threads_per_threadgroup]]) {
+    constexpr int NE = D/32;   // elements a lane holds
+    constexpr int NC = 16;     // rows a staged block holds
+    constexpr int D4 = D/4;
+
+    const int t = tgpig.y;
+    const int h = tgpig.x*ntg.y + sgitg;
+    const bool active = h < args.n_head;
+    const int nthr = ntg.x*ntg.y;
+
+    float qv[NE];
+    float ov[NE];
+    device const float * qp = (device const float *) (q + (active ? h : 0)*args.nb_q1 + t*args.nb_q2);
+    for (int e = 0; e < NE; ++e) {
+        qv[e] = qp[tiisg + 32*e]*args.scale;
+        ov[e] = 0.0f;
+    }
+    float M = -FLT_MAX/2;
+    float S = 0.0f;
+
+    device const int32_t * ip = (device const int32_t *) (ids  + t*args.nb_i1);
+    device const float   * mp = (device const float   *) (mask + t*args.nb_m1);
+    threadgroup T4 * shk4 = (threadgroup T4 *) shk;
+
+    for (int c0 = 0; c0 < args.n_sel; c0 += NC) {
+        const int nc = min(NC, args.n_sel - c0);
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for (int i = tiitg; i < nc*D4; i += nthr) {
+            const int c = i/D4;
+            shk4[i] = ((device const T4 *) (k + (int64_t) ip[c0 + c]*args.nb_k1))[i - c*D4];
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        float s[NC];
+        float bm = M;
+        for (int c = 0; c < NC; ++c) {
+            if (c < nc) {
+                float d = 0.0f;
+                for (int e = 0; e < NE; ++e) {
+                    d += qv[e]*(float) shk[c*D + tiisg + 32*e];
+                }
+                s[c] = simd_sum(d) + mp[c0 + c];
+                bm = max(bm, s[c]);
+            }
+        }
+        const float r = exp(M - bm);
+        S *= r;
+        for (int e = 0; e < NE; ++e) {
+            ov[e] *= r;
+        }
+        for (int c = 0; c < NC; ++c) {
+            if (c < nc) {
+                const float p = exp(s[c] - bm);
+                S += p;
+                for (int e = 0; e < NE; ++e) {
+                    ov[e] += p*(float) shk[c*D + tiisg + 32*e];
+                }
+            }
+        }
+        M = bm;
+    }
+
+    if (!active) {
+        return;
+    }
+    device float * op = (device float *) (dst + h*args.nb_d1 + t*args.nb_d2);
+    const float inv = S == 0.0f ? 0.0f : 1.0f/S;
+    for (int e = 0; e < NE; ++e) {
+        op[tiisg + 32*e] = ov[e]*inv;
+    }
+}
+
+typedef decltype(kernel_sparse_mla<half, half4, 64>)   kernel_sparse_mla_f16_t;
+typedef decltype(kernel_sparse_mla<float, float4, 64>) kernel_sparse_mla_f32_t;
+
+template [[host_name("kernel_sparse_mla_f16_d64")]]  kernel kernel_sparse_mla_f16_t kernel_sparse_mla<half, half4, 64>;
+template [[host_name("kernel_sparse_mla_f16_d128")]] kernel kernel_sparse_mla_f16_t kernel_sparse_mla<half, half4, 128>;
+template [[host_name("kernel_sparse_mla_f16_d256")]] kernel kernel_sparse_mla_f16_t kernel_sparse_mla<half, half4, 256>;
+template [[host_name("kernel_sparse_mla_f16_d512")]] kernel kernel_sparse_mla_f16_t kernel_sparse_mla<half, half4, 512>;
+template [[host_name("kernel_sparse_mla_f32_d64")]]  kernel kernel_sparse_mla_f32_t kernel_sparse_mla<float, float4, 64>;
+template [[host_name("kernel_sparse_mla_f32_d128")]] kernel kernel_sparse_mla_f32_t kernel_sparse_mla<float, float4, 128>;
+template [[host_name("kernel_sparse_mla_f32_d256")]] kernel kernel_sparse_mla_f32_t kernel_sparse_mla<float, float4, 256>;
