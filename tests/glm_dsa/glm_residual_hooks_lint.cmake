# tests/glm_dsa/glm_residual_hooks_lint.cmake - W6 runtime fix (B2.3): every decode path of the fast engine reaches
# the residual through glmres (glm_residual.hpp), never Maya's mHC calls directly.  gf::embed_streams writes
# 4 x n_embd floats and gf::head_prep refuses n_embd > 4096, so a direct call on glm-dsa (one stream, n_embd 6144)
# overwrites the first DSA cache region and fails the head (the MAYA_GLM_SEQS multi decode did, glm_multi.cu).
# Usage: cmake -DSRC=<repo root> -P glm_residual_hooks_lint.cmake
if(NOT DEFINED SRC)
  message(FATAL_ERROR "SRC (the repository root) is not set")
endif()
file(GLOB _files "${SRC}/src/core/*.cu" "${SRC}/src/core/*.cpp" "${SRC}/src/program/*.cpp")
set(_bad "")
foreach(_f IN LISTS _files)
  get_filename_component(_name "${_f}" NAME)
  if(_name STREQUAL "glm_residual.cu")
    continue()   # the one place that calls them (the mHC branch)
  endif()
  # W10 (Maya v1.1.3): Flash-only decode paths that glm-dsa never reaches - checked below that their gates exist:
  #   glm_rows.cu    --parallel's batched rows: rows_alloc is skipped on glm-dsa (glm_rows_ok, glm_multi.cu)
  #   glm_window.cu  the DFlash2 verify window: --dflash is refused on glm-dsa (glm_dflash_ok, glm_model.cu)
  #   glm_mtp_rows.cu  the several-conversation MTP rows: mtpw_alloc / mtpw_ok are gated by glm_rows_ok
  if(_name STREQUAL "glm_rows.cu" OR _name STREQUAL "glm_window.cu" OR _name STREQUAL "glm_mtp_rows.cu")
    continue()
  endif()
  file(STRINGS "${_f}" _lines REGEX "gf::embed_streams\\(|gf::head_prep\\(|embed_streams\\(|head_prep\\(")
  foreach(_l IN LISTS _lines)
    string(STRIP "${_l}" _l)
    if(_l MATCHES "^//")
      continue()
    endif()
    list(APPEND _bad "${_name}: ${_l}")
  endforeach()
endforeach()
# the per-sequence hop slots and hop copies are sized by glmres::res_hop_bytes, not hc x n_embd
file(STRINGS "${SRC}/src/core/glm_multi.cu" _hop REGEX "hop.*g\\.hc \\* g\\.n_embd")
foreach(_l IN LISTS _hop)
  string(STRIP "${_l}" _l)
  list(APPEND _bad "glm_multi.cu (hop sized by hc x n_embd): ${_l}")
endforeach()
file(STRINGS "${SRC}/src/core/glm_multi.cu" _ok REGEX "glmres::res_embed\\(|glmres::res_head\\(|glmres::res_hop_bytes\\(")
list(LENGTH _ok _n_ok)
if(_n_ok LESS 4)
  list(APPEND _bad "glm_multi.cu: expected res_embed, res_head and res_hop_bytes (slot and copy) hooks, found ${_n_ok}")
endif()
file(STRINGS "${SRC}/src/core/glm_multi.cu" _rows_gate REGEX "glm_rows_ok\\(g_\\.arch\\)\\) return rows_alloc")
if(NOT _rows_gate)
  list(APPEND _bad "glm_multi.cu: rows_alloc without the glm_rows_ok(g_.arch) gate (glm_rows.cu is Flash-only)")
endif()
file(STRINGS "${SRC}/src/core/glm_mtp_rows.cu" _mr_gate REGEX "if \\(!glm_rows_ok\\(g_\\.arch\\)\\) return")
list(LENGTH _mr_gate _n_mr)
if(NOT _n_mr EQUAL 2)
  list(APPEND _bad "glm_mtp_rows.cu: mtpw_alloc / mtpw_ok without the glm_rows_ok(g_.arch) gates (found ${_n_mr})")
endif()
file(STRINGS "${SRC}/src/core/glm_model.cu" _df_gate REGEX "glm_dflash_ok\\(g_\\.arch, err\\)")
if(NOT _df_gate)
  list(APPEND _bad "glm_model.cu: no glm_dflash_ok(g_.arch, err) gate (glm_window.cu is Flash-only)")
endif()
if(_bad)
  string(REPLACE ";" "\n  " _msg "${_bad}")
  message(FATAL_ERROR "residual hooks lint: direct mHC residual calls outside glm_residual.cu:\n  ${_msg}")
endif()
message(STATUS "residual hooks lint: every fast decode path goes through glmres (${_n_ok} hooks in glm_multi.cu)")
